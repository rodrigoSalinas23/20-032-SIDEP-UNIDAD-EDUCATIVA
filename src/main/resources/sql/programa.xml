<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.mineduc.sidep.unidadeducativaapi.mappers.ProgramaMapper">
    <resultMap id="programaResultMap" type="cl.mineduc.sidep.unidadeducativaapi.model.ProgramaModel">
        <id property="id" column="pk_prog_id_programa"/>
        <result property="nombre" column="prog_nombre"/>
    </resultMap>

    <select id="findById" resultMap="programaResultMap" parameterType="Long">
        SELECT pk_prog_id_programa, prog_nombre
        FROM programa
        WHERE pk_prog_id_programa = #{id}
    </select>
</mapper>